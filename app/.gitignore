/build
/src/release
# Local debug/release overlays stay ignored, but the instrumentation test
# hosts (manifest, java, res) are tracked source.
/src/debug/*
!/src/debug/AndroidManifest.xml
!/src/debug/java
!/src/debug/res

# Credentials File
.config/secrets.properties
.config/keystore.properties

# Google services local configuration
google-services.json
