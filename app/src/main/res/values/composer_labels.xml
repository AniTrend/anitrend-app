<?xml version="1.0" encoding="utf-8"?>
<!--
    Composer toolbar labels.
    Keep keys in sync with values/composer_labels.xml.
-->
<resources>

    <!-- Composer toolbar action wrapping the selection in bold markdown -->
    <string name="format_bold">Bold</string>

    <!-- Composer toolbar action wrapping the selection in italic markdown -->
    <string name="format_italic">Italic</string>

    <!-- Composer toolbar action converting the selection into a markdown link -->
