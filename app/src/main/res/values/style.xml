<resources>
    <!-- Default Application Theme -->
    <style name="AppTheme" parent="AppThemeLight" />

    <!--
        Theme base styles.
        API-specific attrs (window transitions, status/nav bar colors) live in
        values-v23/ overrides that extend these base styles.
        minSdk = 23 so the v23 overrides always apply.
    -->

    <!-- Light theme shared attributes (no API-specific items) -->
    <style name="AppThemeLightBase" parent="Theme.Material3.Light.NoActionBar">

        <!-- M3 color roles (light scheme) -->
        <item name="colorPrimary">@color/m3_light_primary</item>
        <item name="colorOnPrimary">@color/m3_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/m3_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/m3_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/m3_light_secondary</item>
        <item name="colorOnSecondary">@color/m3_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/m3_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/m3_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/m3_light_tertiary</item>
        <item name="colorOnTertiary">@color/m3_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/m3_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/m3_light_onTertiaryContainer</item>
        <item name="colorError">@color/m3_light_error</item>
        <item name="colorOnError">@color/m3_light_onError</item>
        <item name="colorErrorContainer">@color/m3_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/m3_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/m3_light_surface</item>
        <item name="colorOnBackground">@color/m3_light_onSurface</item>
        <item name="colorSurface">@color/m3_light_surface</item>
        <item name="colorOnSurface">@color/m3_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/m3_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/m3_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/m3_light_outline</item>
        <item name="colorOutlineVariant">@color/m3_light_outlineVariant</item>
        <item name="colorPrimaryInverse">@color/m3_light_inversePrimary</item>
        <item name="colorSurfaceInverse">@color/m3_light_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/m3_light_inverseOnSurface</item>
        <item name="android:colorBackgroundFloating">@color/m3_light_surfaceContainerLow</item>

        <!-- M3 surface container hierarchy (tonal elevation for cards, dialogs, sheets) -->
        <item name="colorSurfaceContainerHighest">@color/m3_light_surfaceContainerHighest</item>
        <item name="colorSurfaceContainerHigh">@color/m3_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainer">@color/m3_light_surfaceContainer</item>
        <item name="colorSurfaceContainerLow">@color/m3_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainerLowest">@color/m3_light_surfaceContainerLowest</item>

        <!-- M3 shape theming -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AniTrend.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AniTrend.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AniTrend.Large</item>

        <!-- M3 typography (with condensed font) -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.AniTrend.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.AniTrend.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.AniTrend.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.AniTrend.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.AniTrend.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.AniTrend.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.AniTrend.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.AniTrend.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.AniTrend.LabelSmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.AniTrend.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.AniTrend.HeadlineSmall</item>

        <!-- Legacy compat attrs (for AppCompat widgets and external libs) -->
        <item name="colorPrimaryDark">@color/m3_light_primaryContainer</item>
        <item name="colorAccent">@color/m3_light_primary</item>

        <!-- Custom theme attributes mapped to M3 color roles -->
        <item name="cardColor">@color/m3_light_surfaceContainerHighest</item>
        <item name="rootColor">@color/m3_light_surface</item>
        <item name="titleColor">@color/m3_light_onSurface</item>
        <item name="subtitleColor">@color/m3_light_onSurfaceVariant</item>
        <item name="contentColor">@color/m3_light_onSurfaceVariant</item>

        <item name="voiceDrawable">@drawable/ic_action_voice_search</item>
        <item name="closeDrawable">@drawable/ic_action_navigation_close</item>
        <item name="backDrawable">@drawable/ic_action_navigation_arrow_back</item>
        <item name="suggestionDrawable">@drawable/ic_suggestion</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="toolbarColor">@style/LightToolbarTheme</item>

        <item name="android:windowBackground">@color/m3_light_surface</item>
    </style>

    <!-- Dark theme shared attributes (no API-specific items) -->
    <style name="AppThemeDarkBase" parent="Theme.Material3.Dark.NoActionBar">

        <!-- M3 color roles (dark scheme) -->
        <item name="colorPrimary">@color/m3_dark_primary</item>
