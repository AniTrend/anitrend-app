        <item name="android:windowBackground">@color/m3_black_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/m3_black_surface</item>
        <item name="android:navigationBarColor">@color/m3_black_surface</item>
        <item name="actionOverflowMenuStyle">@style/DarkOverflowMenu</item>
    </style>

    <style name="DarkOverflowMenu" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/m3_black_surface</item>
    </style>

    <!-- Popup menu styles (Material3 parent) -->
    <style name="PopupThemeLight" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">?attr/rootColor</item>
    </style>

    <style name="PopupThemeDark" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">?attr/rootColor</item>
    </style>

    <!-- Toolbar child themes -->
    <style name="LightToolbarTheme" parent="AppThemeLight">
        <item name="android:textColorPrimary">?attr/titleColor</item>
        <item name="actionMenuTextColor">?attr/titleColor</item>
        <item name="android:textColorSecondary">?attr/subtitleColor</item>
    </style>

    <style name="DarkToolbarTheme" parent="AppThemeDark">
        <item name="android:textColorPrimary">?attr/titleColor</item>
        <item name="actionMenuTextColor">?attr/titleColor</item>
        <item name="android:textColorSecondary">?attr/subtitleColor</item>
    </style>

    <style name="BlackToolbarTheme" parent="AppThemeBlack">
        <item name="android:textColorPrimary">?attr/titleColor</item>
        <item name="actionMenuTextColor">?attr/titleColor</item>
        <item name="android:textColorSecondary">?attr/subtitleColor</item>
    </style>

    <!-- Rating bar styles (migrated to M3) -->
    <style name="SmallRating" parent="Theme.Material3.Light">
        <item name="ratingBarStyle">?android:attr/ratingBarStyleSmall</item>
    </style>


    <!-- Translucent window themes (API-independent base attrs) -->
    <style name="AppThemeDark.TranslucentBase">
        <item name="android:windowBackground">@color/scrim_transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="AppThemeLight.TranslucentBase">
        <item name="android:windowBackground">@color/scrim_transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Misc widget styles -->

    <style name="ImagePreviewToolbar" parent="AppThemeBlack">
        <item name="android:textColorPrimary">?colorOnSurface</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:textColorSecondary">?colorOnSurface</item>
    </style>

</resources>
