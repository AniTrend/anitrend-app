        <item name="colorPrimaryInverse">@color/m3_dark_inversePrimary</item>
        <item name="colorSurfaceInverse">@color/m3_dark_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/m3_dark_inverseOnSurface</item>
        <item name="android:colorBackgroundFloating">@color/m3_dark_surfaceContainerLow</item>

        <!-- M3 surface container hierarchy (tonal elevation for cards, dialogs, sheets) -->
        <item name="colorSurfaceContainerHighest">@color/m3_dark_surfaceContainerHighest</item>
        <item name="colorSurfaceContainerHigh">@color/m3_dark_surfaceContainerHigh</item>
        <item name="colorSurfaceContainer">@color/m3_dark_surfaceContainer</item>
        <item name="colorSurfaceContainerLow">@color/m3_dark_surfaceContainerLow</item>
        <item name="colorSurfaceContainerLowest">@color/m3_dark_surfaceContainerLowest</item>

        <!-- M3 shape theming -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AniTrend.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AniTrend.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AniTrend.Large</item>

        <!-- M3 typography (with condensed font) -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.AniTrend.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.AniTrend.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.AniTrend.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.AniTrend.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.AniTrend.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.AniTrend.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.AniTrend.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.AniTrend.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.AniTrend.LabelSmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.AniTrend.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.AniTrend.HeadlineSmall</item>

        <!-- Legacy compat attrs -->
        <item name="colorPrimaryDark">@color/m3_dark_primaryContainer</item>
        <item name="colorAccent">@color/m3_dark_primary</item>

        <!-- Custom theme attributes mapped to M3 color roles -->
        <item name="cardColor">@color/m3_dark_surfaceContainerHighest</item>
        <item name="rootColor">@color/m3_dark_surface</item>
        <item name="titleColor">@color/m3_dark_onSurface</item>
        <item name="subtitleColor">@color/m3_dark_onSurfaceVariant</item>
        <item name="contentColor">@color/m3_dark_onSurfaceVariant</item>

        <item name="voiceDrawable">@drawable/ic_action_voice_search_inverted</item>
        <item name="closeDrawable">@drawable/ic_action_navigation_close_inverted</item>
        <item name="backDrawable">@drawable/ic_action_navigation_arrow_back_inverted</item>
        <item name="suggestionDrawable">@drawable/ic_suggestion</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="toolbarColor">@style/DarkToolbarTheme</item>

        <item name="android:windowBackground">@color/m3_dark_surface</item>
    </style>


    <!-- App bar and popup overlays (migrated to M3) -->
    <style name="AppThemeLight.AppBarOverlay" parent="ThemeOverlay.Material3.Light" />
    <style name="AppThemeLight.PopupOverlay" parent="ThemeOverlay.Material3" />
    <style name="AppThemeDark.AppBarOverlay" parent="ThemeOverlay.Material3.Dark" />
    <style name="AppThemeDark.PopupOverlay" parent="ThemeOverlay.Material3" />

    <!-- AMOLED Black theme (API-independent, already dark) -->
    <style name="AppThemeBlack" parent="Theme.Material3.Dark.NoActionBar">

        <!-- M3 color roles (dark scheme with black surface) -->
        <item name="colorPrimary">@color/m3_dark_primary</item>
        <item name="colorOnPrimary">@color/m3_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/m3_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/m3_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/m3_dark_secondary</item>
        <item name="colorOnSecondary">@color/m3_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/m3_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/m3_dark_onSecondaryContainer</item>
        <item name="colorTertiary">@color/m3_dark_tertiary</item>
        <item name="colorOnTertiary">@color/m3_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/m3_dark_tertiaryContainer</item>
