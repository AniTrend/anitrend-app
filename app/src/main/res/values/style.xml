        <item name="colorTertiaryContainer">@color/m3_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/m3_dark_onTertiaryContainer</item>
        <item name="colorError">@color/m3_dark_error</item>
        <item name="colorOnError">@color/m3_dark_onError</item>
        <item name="colorErrorContainer">@color/m3_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/m3_dark_onErrorContainer</item>
        <item name="android:colorBackground">@color/m3_dark_surface</item>
        <item name="colorOnBackground">@color/m3_dark_onSurface</item>
        <item name="colorSurface">@color/m3_dark_surface</item>
        <item name="colorOnSurface">@color/m3_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/m3_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/m3_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/m3_dark_outline</item>
