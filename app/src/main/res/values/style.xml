        <item name="colorErrorContainer">@color/m3_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/m3_dark_onErrorContainer</item>
        <item name="android:colorBackground">@color/m3_black_surface</item>
        <item name="colorOnBackground">@color/m3_dark_onSurface</item>
        <item name="colorSurface">@color/m3_black_surface</item>
        <item name="colorOnSurface">@color/m3_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/m3_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/m3_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/m3_dark_outline</item>
        <item name="colorOutlineVariant">@color/m3_dark_outlineVariant</item>
        <item name="colorPrimaryInverse">@color/m3_dark_inversePrimary</item>
        <item name="colorSurfaceInverse">@color/m3_dark_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/m3_dark_inverseOnSurface</item>
        <item name="android:colorBackgroundFloating">@color/m3_black_surface</item>

        <!-- M3 surface container hierarchy (all black for AMOLED) -->
        <item name="colorSurfaceContainerHighest">@color/m3_black_surfaceContainerHighest</item>
        <item name="colorSurfaceContainerHigh">@color/m3_black_surfaceContainerHigh</item>
        <item name="colorSurfaceContainer">@color/m3_black_surfaceContainer</item>
        <item name="colorSurfaceContainerLow">@color/m3_black_surfaceContainerLow</item>
        <item name="colorSurfaceContainerLowest">@color/m3_black_surfaceContainerLowest</item>

        <!-- M3 shape theming -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AniTrend.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AniTrend.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AniTrend.Large</item>

        <!-- M3 typography -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.AniTrend.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.AniTrend.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.AniTrend.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.AniTrend.BodyLarge</item>
