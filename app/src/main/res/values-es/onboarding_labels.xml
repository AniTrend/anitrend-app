<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding tour copy for the four-page first-run flow. -->
<resources>
    <!-- Onboarding page 1 heading about discovering media -->
    <string name="title_onboarding_discover">Encuentra tu próxima historia</string>
    <!-- Onboarding page 1 supporting copy about exploring and filtering media -->
    <string name="description_onboarding_discover">Explora anime y manga, y luego reduce la lista con filtros que se ajusten a lo que quieres ver o leer.</string>

