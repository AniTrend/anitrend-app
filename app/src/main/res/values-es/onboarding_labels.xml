    <string name="action_onboarding_next">Siguiente</string>

    <!-- Onboarding action completing the tour with an existing session -->
    <string name="action_onboarding_continue">Continuar</string>

    <!-- Onboarding action opening the privacy controls sheet -->
    <string name="action_onboarding_privacy_choices">Opciones de privacidad</string>
    <!-- Onboarding action returning to the previous page -->
    <string name="action_onboarding_previous">Anterior</string>
    <!-- Onboarding action opening the AniList sign-in flow -->
    <string name="action_onboarding_connect">Conectar AniList</string>
    <!-- Onboarding action completing the tour without an account -->
    <string name="action_onboarding_continue_as_guest">Continuar como invitado</string>

    <!-- Onboarding page position indicator; %1$d is the current page number, %2$d is the total page count -->
    <string name="label_onboarding_page_indicator" formatted="true">Página %1$d de %2$d</string>
