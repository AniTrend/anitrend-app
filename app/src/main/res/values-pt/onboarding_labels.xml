    <string name="action_onboarding_previous">Anterior</string>
    <!-- Onboarding action opening the AniList sign-in flow -->
    <string name="action_onboarding_connect">Conectar AniList</string>
    <!-- Onboarding action completing the tour without an account -->
    <string name="action_onboarding_continue_as_guest">Continuar como convidado</string>

    <!-- Onboarding page position indicator; %1$d is the current page number, %2$d is the total page count -->
