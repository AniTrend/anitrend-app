<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme (API 23+) - extends shared base with API-level additions -->
    <style name="AppThemeLight" parent="AppThemeLightBase">
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowSharedElementsUseOverlay">true</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/m3_light_primaryContainer</item>
        <item name="android:navigationBarColor">@color/m3_light_surfaceDim</item>

        <item name="android:popupMenuStyle">@style/PopupThemeLight</item>
    </style>

    <!-- Dark theme (API 23+) -->
    <style name="AppThemeDark" parent="AppThemeDarkBase">
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowSharedElementsUseOverlay">true</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryDark</item>

        <item name="android:popupMenuStyle">@style/PopupThemeDark</item>
    </style>

    <!-- Translucent themes with API 23+ transparent bars -->
    <style name="AppThemeDark.Translucent" parent="AppThemeDark.TranslucentBase">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppThemeLight.Translucent" parent="AppThemeLight.TranslucentBase">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Material tip button with v23+ attrs -->
    <style name="MaterialTipButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?colorOnPrimary</item>
    </style>

</resources>
