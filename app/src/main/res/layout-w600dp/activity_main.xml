<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanded shell (windows at least 600dp wide): Material 3 navigation rail
    beside the same app bar + NavHost content host used by the compact
    layout/activity_main.xml. Insets are owned by this shell; fragments must
    not add per-fragment padding to clear the navigation surface.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:fitsSystemWindows="true">

    <include
        layout="@layout/primary_navigation_rail"
        android:layout_width="wrap_content"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/app_bar_main"
        layout="@layout/app_bar_main"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

</LinearLayout>