<?xml version="1.0" encoding="utf-8"?>
<com.mxt.anitrend.base.custom.view.container.CardViewBase xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/lg_margin">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_series_season" />

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:id="@+id/series_season_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textIsSelectable="true"
                    tools:text="2015 Fall" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_series_origin" />

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:id="@+id/series_origin_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textIsSelectable="true"
                    tools:text="Manga" />
            </LinearLayout>

        </LinearLayout>

        <androidx.legacy.widget.Space
            android:id="@+id/manga_section_space"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/xl_margin"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/manga_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_total_chapters" />

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:id="@+id/total_chapters_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textIsSelectable="true"
                    tools:text="12 Chapters" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_total_volumes" />

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:id="@+id/total_volumes_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textIsSelectable="true"
                    tools:text="24 Volumes" />
            </LinearLayout>

        </LinearLayout>

        <androidx.legacy.widget.Space
            android:id="@+id/anime_section_space"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/xl_margin"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/anime_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_total_episodes" />

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:id="@+id/total_episodes_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textIsSelectable="true"
                    tools:text="12 Episodes" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_episode_duration" />

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:id="@+id/episode_duration_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textIsSelectable="true"
                    tools:text="24 Minutes" />
            </LinearLayout>

        </LinearLayout>

        <androidx.legacy.widget.Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/xl_margin" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_hash_tag" />

                <com.mxt.anitrend.base.custom.view.text.RichMarkdownTextView
                    android:id="@+id/hash_tag_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textIsSelectable="true"
                    tools:text="#onepunchman" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_series_score" />

            <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                android:id="@+id/series_score_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed-light"
                android:textIsSelectable="true"
                tools:text="85% Mean" />
        </LinearLayout>

        </LinearLayout>

        <androidx.legacy.widget.Space
            android:id="@+id/anime_details_space"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/xl_margin"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/anime_details_section"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/anime_main_studio_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground">

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_main_studio" />

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:id="@+id/main_studio_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textIsSelectable="true"
                    android:textColor="?colorAccent"
                    tools:text="MADHOUSE" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_next_episode" />

                <com.mxt.anitrend.base.custom.view.text.AiringTextView
                    android:id="@+id/next_episode_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textIsSelectable="true"
                    tools:text="EP 3 Airing In 2 days" />
            </LinearLayout>

        </LinearLayout>

        <androidx.legacy.widget.Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/xl_margin" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_series_status" />

                <com.mxt.anitrend.base.custom.view.text.SingleLineTextView
                    android:id="@+id/series_status_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed-light"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textIsSelectable="true"
                    tools:text="Not Released" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    </com.mxt.anitrend.base.custom.view.container.CardViewBase>