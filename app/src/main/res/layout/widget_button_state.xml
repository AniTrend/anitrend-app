<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_flipper"
    android:clickable="true"
    android:focusable="true"
    android:inAnimation="@android:anim/slide_in_left"
    android:outAnimation="@android:anim/slide_out_right"
    android:foreground="?selectableItemBackground"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/follow" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="@dimen/widget_spinner_compact_size"
            android:layout_height="@dimen/widget_spinner_compact_size"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="?colorAccent" />

    </ViewFlipper>
