<?xml version="1.0" encoding="utf-8"?>
<!-- Profile screen. The header is a collapsing app bar with three tiers:
     1. Banner (atmosphere, parallax) with a gradient scrim for contrast.
     2. Identity tier (avatar + display name + handle) anchored over the
        banner bottom.
     3. Stats widget (secondary tier) on a surface container below the
        collapsing header.
     A pinned TabLayout sits below the stats, and the ViewPager content
     fills the remaining space. A state overlay covers the content area
     for loading and error states. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLowest">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/profile_header_height"
            app:titleEnabled="false"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!-- Banner (atmosphere) -->
            <com.mxt.anitrend.base.custom.view.image.WideImageView
                android:id="@+id/profile_banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/profile_banner_description"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.4"
                tools:src="@sample/darling" />

            <!-- Scrim over banner for identity contrast -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_shadow"
                app:layout_collapseMode="parallax" />

            <!-- Transparent toolbar (pinned at top, stays visible on collapse) -->
            <include
                android:id="@+id/toolbar"
                app:layout_collapseMode="pin"
                layout="@layout/custom_toolbar_transparent" />

            <!-- Identity tier (anchored at banner bottom) -->
            <LinearLayout
                android:id="@+id/profile_identity_tier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/xl_margin"
                android:paddingBottom="@dimen/lg_margin"
                app:layout_collapseMode="parallax">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profile_avatar"
                    android:layout_width="@dimen/profile_avatar_size"
                    android:layout_height="@dimen/profile_avatar_size"
                    android:contentDescription="@string/profile_avatar_description"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.AniTrend.Circle"
                    app:strokeColor="?attr/colorSurfaceContainerHighest"
                    app:strokeWidth="2dp"
                    tools:src="@drawable/avatar_placeholder" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/xl_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/profile_display_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/white"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="wax911" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/profile_handle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sm_margin"
                        android:alpha="0.8"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/white"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="\@wax911" />
                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Stats widget (secondary tier, on a surface container) -->
        <com.mxt.anitrend.base.custom.view.widget.ProfileStatsWidget
            android:id="@+id/profile_stats_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            app:layout_scrollFlags="scroll" />

        <!-- Pinned tab row -->
        <include
            android:id="@+id/smart_tab"
            layout="@layout/custom_tab" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ViewPager content -->
    <include
        android:id="@+id/page_container"
        layout="@layout/content_view_pager" />

    <!-- State overlay (loading / error) covers the content area -->
    <FrameLayout
        android:id="@+id/profile_state_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainerLowest"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:visibility="gone">

        <!-- Loading state -->
        <LinearLayout
            android:id="@+id/profile_loading_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xs">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/profile_loading_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorSize="40dp"
                app:trackThickness="4dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/profile_loading_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lg_margin"
                android:text="@string/profile_loading"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Error state -->
        <LinearLayout
            android:id="@+id/profile_error_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xs"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_emoji_sweat"
                app:tint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/profile_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/lg_margin"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Couldn\'t load profile" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_error_retry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xl_margin"
                android:minHeight="48dp"
                android:text="@string/profile_retry" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
