<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact shell (windows below 600dp): app bar + NavHost above a Material 3
    bottom navigation bar. The w600dp variant places a navigation rail beside
    the same content host instead. Insets are owned by this shell; fragments
    must not add per-fragment padding to clear the navigation surface.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/app_bar_main"
        layout="@layout/app_bar_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        layout="@layout/primary_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>