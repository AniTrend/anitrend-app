<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding tour copy for the four-page first-run flow. -->
<resources>
    <!-- Onboarding page 1 heading about discovering media -->
    <string name="title_onboarding_discover">Trouvez votre prochaine histoire</string>
    <!-- Onboarding page 1 supporting copy about exploring and filtering media -->
    <string name="description_onboarding_discover">Explorez animes et mangas, puis affinez la liste avec des filtres adaptés à ce que vous voulez regarder ou lire.</string>

    <!-- Onboarding page 2 heading about tracking lists -->
    <string name="title_onboarding_track">Gardez vos listes à jour</string>
    <!-- Onboarding page 2 supporting copy about saving media and updating progress -->
    <string name="description_onboarding_track">Enregistrez animes et mangas dans vos listes, passez à En cours et mettez à jour votre progression au fil de vos visionnages ou lectures.</string>

    <!-- Onboarding page 3 heading about social features -->
    <string name="title_onboarding_social">Suivez la conversation</string>
    <!-- Onboarding page 3 supporting copy about activity, comments and messages -->
    <string name="description_onboarding_social">Parcourez l\'activité AniList, participez aux commentaires et réponses, et utilisez la messagerie. Connectez AniList quand vous le souhaitez.</string>

    <!-- Onboarding page 4 heading about choosing how to start -->
    <string name="title_onboarding_start">Commencez à votre façon</string>
    <!-- Onboarding page 4 supporting copy about connecting an account or continuing as a guest -->
    <string name="description_onboarding_start">Connectez AniList pour les actions liées au compte ou continuez en tant qu\'invité. Vous pourrez vous connecter plus tard.</string>

    <!-- Onboarding action advancing to the next page -->
    <string name="action_onboarding_next">Suivant</string>

    <!-- Onboarding action completing the tour with an existing session -->
    <string name="action_onboarding_continue">Continuer</string>

    <!-- Onboarding action opening the privacy controls sheet -->
    <string name="action_onboarding_privacy_choices">Choix de confidentialité</string>
    <!-- Onboarding action returning to the previous page -->
    <string name="action_onboarding_previous">Précédent</string>
    <!-- Onboarding action opening the AniList sign-in flow -->
    <string name="action_onboarding_connect">Connecter AniList</string>
    <!-- Onboarding action completing the tour without an account -->
    <string name="action_onboarding_continue_as_guest">Continuer en tant qu\'invité</string>

    <!-- Onboarding page position indicator; %1$d is the current page number, %2$d is the total page count -->
    <string name="label_onboarding_page_indicator" formatted="true">Page %1$d sur %2$d</string>
