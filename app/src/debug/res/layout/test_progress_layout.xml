<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/progressLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/contentChild"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Content Child" />

    <Button
        android:id="@+id/secondContentChild"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Second Child" />

    <TextView
        android:id="@+id/initiallyGoneContentChild"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Initially Gone Child"
        android:visibility="gone" />

    <TextView
        android:id="@+id/initiallyInvisibleContentChild"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Initially Invisible Child"
        android:visibility="invisible" />

</FrameLayout>
